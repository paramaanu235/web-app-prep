---
import BaseLayout from '../layouts/BaseLayout.astro';
import Progress from '../components/islands/Progress';
import { loadContent } from '../content-pipeline';

const content = await loadContent();
const tracker = content.manifest.documents.find((d) => d.sourceFilename === 'weekly_tracker.md');
---

<BaseLayout title="Progress" current="progress">
  <Progress client:load base={import.meta.env.BASE_URL} trackerDocId={tracker?.id} />
</BaseLayout>
