---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPage from '../components/islands/SearchPage';
import { loadContent } from '../content-pipeline';

const content = await loadContent();
const categories = content.categories.map((c) => ({ id: c.id, name: c.name }));
---

<BaseLayout title="Search" current="search">
  <SearchPage client:load base={import.meta.env.BASE_URL} categories={categories} />
</BaseLayout>
